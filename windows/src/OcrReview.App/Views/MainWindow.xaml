<Window x:Class="OcrReview.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OcrReview.App.Views"
        Title="OCR Review" Height="780" Width="1200" MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding RecognizePageCommand}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding ToggleFindCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="D" Command="{Binding DenoiseCommand}"/>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding ShowPaletteCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="E" Command="{Binding ExportMarkdownCommand}"/>
        <KeyBinding Modifiers="Control+Alt" Key="E" Command="{Binding ExportDocxCommand}"/>
        <KeyBinding Modifiers="Control+Alt" Key="H" Command="{Binding ToggleHeatmapCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding NextIssueCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding PreviousIssueCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ZoomFitCommand}"/>
    </Window.InputBindings>

    <Grid>
        <views:WelcomeView Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}"/>
        <views:WorkspaceView Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"/>
        <views:CommandPaletteView Visibility="{Binding IsCommandPaletteVisible, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
