<UserControl x:Class="OcrReview.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">
    <Grid Background="{StaticResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" MaxWidth="640" Margin="32,56,32,40">

                <!-- Hero -->
                <Border Width="84" Height="84" CornerRadius="22" Background="{StaticResource BrandGradient}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="OCR Review" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock Text="Recognize, review, and perfect text from any scanned PDF or image — then export to Markdown, Word, or a searchable PDF."
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Center"/>

                <!-- Drop zone -->
                <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceBrush}" Padding="24,28"
                        Margin="0,28" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag a PDF or image here" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="PDF · PNG · JPEG · TIFF · BMP" FontSize="11.5"
                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Content="Open Document" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Recents -->
                <TextBlock Text="RECENT DOCUMENTS" FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource DimBrush}" Margin="2,0,0,10"
                           Visibility="{Binding Recents.Count, Converter={StaticResource CountToVis}}"/>
                <ItemsControl ItemsSource="{Binding Recents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,0,8"
                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Style="{StaticResource Card}" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="44" Height="52" CornerRadius="8"
                                                        Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                               Foreground="{StaticResource AccentBrightBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Filename}" FontSize="13.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TotalPageCount, StringFormat={}{0} pages}"
                                                               FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="{StaticResource DimBrush}"
                                                           Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, HH:mm}'}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" ToolTip="Settings">
            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"/>
        </Button>
    </Grid>
</UserControl>
