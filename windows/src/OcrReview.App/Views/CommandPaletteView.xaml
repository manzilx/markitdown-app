<UserControl x:Class="OcrReview.App.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="OnVisibleChanged">
    <Grid>
        <Rectangle Fill="#73000000" MouseDown="OnScrimClick"/>

        <Border Width="600" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0"
                Style="{StaticResource Card}" Background="{StaticResource SurfaceHighBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="14">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}" FontSize="16"
                             Background="Transparent" BorderThickness="0"
                             TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"/>
                    <TextBlock x:Name="Placeholder" Text="Search commands…" Foreground="{StaticResource DimBrush}"
                               FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Border Height="1" Background="{StaticResource HairlineBrush}"/>
                <ListBox x:Name="ResultList" MaxHeight="400" Background="Transparent" BorderThickness="0"
                         Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnResultClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="12,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Group}" FontSize="10.5" Foreground="{StaticResource DimBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="5" Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="6,2"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Shortcut, Converter={StaticResource EmptyStringToCollapsed}}">
                                    <TextBlock Text="{Binding Shortcut}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
