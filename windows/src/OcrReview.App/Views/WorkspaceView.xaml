<UserControl x:Class="OcrReview.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OcrReview.App.Views"
             TextElement.Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="14,8">

                <!-- Right: actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ShowPaletteCommand}" ToolTip="Command palette (Ctrl+K)">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFindCommand}" ToolTip="Find &amp; replace (Ctrl+F)">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding DenoiseCommand}"
                            ToolTip="Denoise — remove repeated headers, footers &amp; page numbers (Ctrl+Shift+D)">
                        <TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>

                    <!-- Recognize -->
                    <Grid Margin="6,0,0,0">
                        <ToggleButton x:Name="RecognizeToggle" Style="{StaticResource ChipToggle}" Content="Recognize ⌄"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=RecognizeToggle}" StaysOpen="False"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceHighBrush}"
                                    Padding="6" Margin="0,4,0,0" Button.Click="OnMenuItemClick" Tag="{Binding ElementName=RecognizeToggle}">
                                <StackPanel MinWidth="190">
                                    <Button Style="{StaticResource MenuItemButton}" Content="This Page" Command="{Binding RecognizePageCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="All Pages…" Command="{Binding RecognizeAllCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Pages -->
                    <Grid Margin="6,0,0,0">
                        <ToggleButton x:Name="PagesToggle" Style="{StaticResource ChipToggle}" Content="Pages ⌄"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=PagesToggle}" StaysOpen="False"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceHighBrush}"
                                    Padding="6" Margin="0,4,0,0" Button.Click="OnMenuItemClick" Tag="{Binding ElementName=PagesToggle}">
                                <StackPanel MinWidth="200">
                                    <Button Style="{StaticResource MenuItemButton}" Content="Rotate Right" Command="{Binding RotateRightCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Rotate Left" Command="{Binding RotateLeftCommand}"/>
                                    <Separator Background="{StaticResource HairlineBrush}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Append PDFs…" Command="{Binding AppendCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Combine PDFs…" Command="{Binding CombineCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Extract Pages…" Command="{Binding ExtractCommand}"/>
                                    <Separator Background="{StaticResource HairlineBrush}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Delete This Page…" Command="{Binding DeletePageCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Export -->
                    <Grid Margin="6,0,0,0">
                        <ToggleButton x:Name="ExportToggle" Style="{StaticResource PrimaryChipToggle}" Content="Export ⌄"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ExportToggle}" StaysOpen="False"
                               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceHighBrush}"
                                    Padding="6" Margin="0,4,0,0" Button.Click="OnMenuItemClick" Tag="{Binding ElementName=ExportToggle}">
                                <StackPanel MinWidth="210">
                                    <Button Style="{StaticResource MenuItemButton}" Content="Markdown (.md)" Command="{Binding ExportMarkdownCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Word (.docx)" Command="{Binding ExportDocxCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Searchable PDF" Command="{Binding ExportSearchablePdfCommand}"/>
                                    <Separator Background="{StaticResource HairlineBrush}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Plain Text (.txt)" Command="{Binding ExportTextCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Rich Text (.rtf)" Command="{Binding ExportRtfCommand}"/>
                                    <Separator Background="{StaticResource HairlineBrush}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Copy Page Text" Command="{Binding CopyPageCommand}"/>
                                    <Button Style="{StaticResource MenuItemButton}" Content="Copy All Text" Command="{Binding CopyAllCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Left: title + nav + review -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" ToolTip="Back to library">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>

                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Document.Filename}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EngineShortLabel}" FontSize="11" Foreground="{StaticResource DimBrush}"/>
                            <TextBlock Text="· Edited" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="5,0,0,0"
                                       Visibility="{Binding PdfModified, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="5,0,0,0"
                                       Text="· partial OCR"
                                       Visibility="{Binding PartialOcr, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Page nav -->
                    <Border Margin="16,0,0,0" CornerRadius="9" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding PreviousPageCommand}">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <TextBox Width="34" Background="Transparent" BorderThickness="0" TextAlignment="Center"
                                     Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                                     Text="{Binding PageJumpText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding JumpToPageCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{Binding TotalPages, StringFormat=/ {0}}" Foreground="{StaticResource DimBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding NextPageCommand}">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Review HUD -->
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Document.OcrPageCount, Converter={StaticResource CountToVis}}">
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding PreviousIssueCommand}" ToolTip="Previous issue (Alt+Up)">
                            <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                        <Border CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Padding="9,4" Margin="2,0">
                            <TextBlock Text="{Binding ReviewSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrightBrush}"/>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding NextIssueCommand}" ToolTip="Next issue (Alt+Down)">
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleHeatmapCommand}" ToolTip="Confidence heatmap (Ctrl+Alt+H)">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Width="90" Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceHighBrush}" BorderThickness="0"/>
                        <TextBlock Text="Working…" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- FIND BAR -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="16,8" Visibility="{Binding IsFindVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="200" Style="{StaticResource DarkTextBox}" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding FindNextCommand}"/></TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{Binding FindSummary}" Foreground="{StaticResource DimBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding FindPreviousCommand}"><TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"/></Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding FindNextCommand}"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/></Button>
                <TextBox Width="180" Style="{StaticResource DarkTextBox}" Margin="10,0,0,0" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource GhostButton}" Content="Replace" Command="{Binding ReplaceCommand}" Margin="6,0,0,0"/>
                <Button Style="{StaticResource SoftButton}" Content="All" Command="{Binding ReplaceAllCommand}" Margin="6,0,0,0"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFindCommand}" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Page pane -->
            <Grid Grid.Column="0" Background="{StaticResource BgBrush}" ClipToBounds="True">
                <views:PdfPageView Margin="12" RenderTransformOrigin="0.5,0.5">
                    <views:PdfPageView.RenderTransform>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                    </views:PdfPageView.RenderTransform>
                </views:PdfPageView>

                <!-- Zoom controls -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                        CornerRadius="20" Background="{StaticResource SurfaceHighBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="26" Command="{Binding ZoomOutCommand}"><TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                        <Button Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding ZoomActualCommand}">
                            <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="26" Command="{Binding ZoomInCommand}"><TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="26" Command="{Binding ZoomFitCommand}" ToolTip="Fit to window"><TextBlock Text="&#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="12"/></Button>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Editor -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Redact" Command="{Binding ToggleRedactionCommand}"
                                    Visibility="{Binding SelectedBlockId, Converter={StaticResource NotNullToVis}}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Revert" Command="{Binding RevertSelectionCommand}"/>
                        </StackPanel>
                        <TextBlock Text="Recognized text" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </DockPanel>

                    <!-- suspects -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding LowConfidenceBlocks}" Margin="0,0,0,8"
                                  Visibility="{Binding LowConfidenceBlocks.Count, Converter={StaticResource CountToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6"
                                        Command="{Binding DataContext.SelectBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="10" Background="#22FBBC4D" BorderBrush="#66FBBC4D" BorderThickness="1" Padding="9,4">
                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- spell suggestions -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ActiveSpellIssues}" Margin="0,0,0,8"
                                  Visibility="{Binding ActiveSpellIssues.Count, Converter={StaticResource CountToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Word}" Foreground="{StaticResource DangerBrush}" FontSize="12.5"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ApplySpellFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="10" Background="#2261A8FA" BorderBrush="#6661A8FA" BorderThickness="1" Padding="9,3">
                                                                <TextBlock Text="{Binding Suggestion}" FontSize="12" Foreground="{StaticResource InfoBrush}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- editor -->
                    <Border Grid.Row="3" CornerRadius="10" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBox Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource AccentBrightBrush}" FontFamily="Consolas" FontSize="13.5"
                                     Padding="10" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding CurrentText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding CurrentPagePlaceholder}" Foreground="{StaticResource DimBrush}"
                                       FontSize="13" Margin="14" IsHitTestVisible="False" TextWrapping="Wrap" VerticalAlignment="Top"
                                       Visibility="{Binding CurrentPagePlaceholder, Converter={StaticResource EmptyStringToCollapsed}}"/>
                        </Grid>
                    </Border>

                    <!-- footer -->
                    <TextBlock Grid.Row="4" Text="{Binding EditorModeLabel}" Foreground="{StaticResource DimBrush}"
                               FontSize="11" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- THUMBNAILS -->
        <views:ThumbnailStrip Grid.Row="3" Visibility="{Binding TotalPages, Converter={StaticResource CountToVis}}"/>
    </Grid>
</UserControl>
