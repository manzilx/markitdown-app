<UserControl x:Class="OcrReview.App.Views.ThumbnailStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="PAGES" FontSize="10.5" FontWeight="Bold"
                       Foreground="{StaticResource DimBrush}" Margin="16,8,0,0"/>
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Margin="8,4,8,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Loaded="OnThumbLoaded" DataContextChanged="OnThumbDataContextChanged" Cursor="Hand">
                            <Border Width="62" Height="80" CornerRadius="6" Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                             Fill="{Binding StatusBrush}"
                                             Visibility="{Binding StatusBrush, Converter={StaticResource NotNullToVis}}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding PageNumber}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{StaticResource DimBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
