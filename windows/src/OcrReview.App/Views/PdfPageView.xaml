<UserControl x:Class="OcrReview.App.Views.PdfPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent" ClipToBounds="True">
        <Image x:Name="PageImage" Source="{Binding CurrentPageImage}" Stretch="Uniform"
               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"
               SizeChanged="OnImageSizeChanged"/>
        <Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="OnOverlayClick"/>
    </Grid>
</UserControl>
