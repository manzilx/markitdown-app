<Window x:Class="OcrReview.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="500" Height="460"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" TextElement.Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource BrandGradient}">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="OCR Review" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="On-device OCR with human review · v1.0" FontSize="11" Foreground="{StaticResource DimBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- OCR engine -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="OCR ENGINE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="EngineCombo" Height="30"/>
            <TextBlock x:Name="EngineDescription" FontSize="11" Foreground="{StaticResource DimBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Sidecar -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="PYTHON SIDECAR" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource DimBrush}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Checking…" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button x:Name="RestartButton" Content="Restart" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="OnRestart"/>
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource GhostButton}" Click="OnRefresh"/>
            </StackPanel>
            <TextBlock Text="Project path" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,4,0,2"/>
            <TextBox x:Name="ProjectRootBox" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" FontSize="12"/>
            <TextBlock Text="Sidecar URL" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,8,0,2"/>
            <TextBox x:Name="UrlBox" Style="{StaticResource DarkTextBox}" FontFamily="Consolas" FontSize="12"/>
            <TextBlock Text="Word export, searchable PDF, and sidecar OCR engines need the Python sidecar. Windows OCR works without it."
                       FontSize="11" Foreground="{StaticResource DimBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
