<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10.0.19041 TFM gives WinRT projections: Windows.Media.Ocr, Windows.Data.Pdf, Windows.Globalization. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OcrReview</AssemblyName>
    <RootNamespace>OcrReview.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- Allowed publish RIDs; not forced on normal build so CI passes -r win-x64. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;arm64;AnyCPU</Platforms>
    <!-- Allow compile-checking the Windows app on macOS/Linux CI (does not run there). -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcrReview.Core\OcrReview.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows.Data.Pdf renders pages; PdfSharp handles structure edits (rotate/reorder/merge/split/save). -->
    <PackageReference Include="PdfSharp" Version="6.1.1" />
  </ItemGroup>

</Project>

