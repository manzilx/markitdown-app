<Application x:Class="OcrReview.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OcrReview.App.Converters">
    <!-- No StartupUri: the window is created in OnStartup inside a try/catch so a
         startup failure shows a dialog instead of an invisible zombie process. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OcrReview;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
            <conv:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsed"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
