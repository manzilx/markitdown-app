# Default conversion engine: builtin | azure_doc_intel | pymupdf4llm | ocr_plugin
MARKITDOWN_DEFAULT_ENGINE=builtin

# Azure Document Intelligence (engine: azure_doc_intel)
MARKITDOWN_DOCINTEL_ENDPOINT=
# AZURE_API_KEY=                         # or DefaultAzureCredential locally

# LLM for OCR plugin (engine: ocr_plugin) — OpenAI-compatible
MARKITDOWN_LLM_BASE_URL=http://localhost:1234/v1
MARKITDOWN_LLM_API_KEY=lm-studio
MARKITDOWN_LLM_MODEL=gpt-4o
